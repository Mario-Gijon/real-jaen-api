# Backend side of the isolated acquisition test stack (compose.test.yaml), never a habitual installation.
# The backend never receives acquisition code: only its own context, its fixtures and the test driver.
ARG BACKEND_IMAGE=local/backend-runtime:required
FROM ${BACKEND_IMAGE} AS backend-test
HEALTHCHECK NONE
COPY --from=backend / /app/
COPY --from=fixtures / /app/tests/
COPY --from=checks integration_flow.py /opt/checks/
ENV PYTHONPATH=/app:/opt/checks:/app/tests
WORKDIR /app
ENTRYPOINT ["python", "-B", "-m", "integration_flow"]
