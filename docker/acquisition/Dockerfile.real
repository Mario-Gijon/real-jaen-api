# Single real SDK acquisition (scripts/prueba_real_sdk.py). Built from `git archive` of one commit, never from the
# working tree, and run without any source mount. RUNTIME is the acquisition runtime target built from that same
# archive; `source` contains exactly the files below. Build never installs or downloads.
ARG RUNTIME
FROM ${RUNTIME}
COPY --from=source acquisition/pilot_bundle.py acquisition/pilot_transport.py acquisition/sdk_transport.py acquisition/sofascore_offline.py /opt/app/acquisition/
COPY --from=source api.py importar.py /opt/app/
COPY --from=source persistencia/bundle_v2.py /opt/app/persistencia/bundle_v2.py
COPY --from=source docker/acquisition/real_sdk.py /opt/app/real_sdk.py
ENV PYTHONPATH=/opt/app:/opt/scraper
USER 10001:10001
ENTRYPOINT ["python", "-B", "/opt/app/real_sdk.py"]
